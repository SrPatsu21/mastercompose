# =============================================
# HTTP → HTTPS
# =============================================

server {

    listen 80;
    listen [::]:80;

    server_name _;

    return 301 https://$host$request_uri;
}


# =============================================
# Main HTTPS
# =============================================

server {

    listen 443 ssl;
    listen [::]:443 ssl;

    server_name _;

    ssl_certificate     ${NG_CERT_PATH}fullchain.pem;
    ssl_certificate_key ${NG_KEY_PATH}privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}