# SERVER: backrest.paulosergio.pierdona.nom.br
# ============================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name backrest.${CF_HOSTNAME};

    ssl_certificate     ${NG_CERT_PATH}backrest.paulosergio.pierdona.nom.br-fullchain.pem;
    ssl_certificate_key ${NG_KEY_PATH}backrest.paulosergio.pierdona.nom.br-privkey.pem;
    ssl_dhparam         ${NG_DHPARAMS};

    include /etc/letsencrypt/options-ssl-nginx.conf;

    location / {
        proxy_pass http://backrest_upstream;
