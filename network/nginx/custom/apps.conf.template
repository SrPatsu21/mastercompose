# =============================================
# Global Resolver
# =============================================
resolver 127.0.0.11 valid=30s ipv6=off;

# =============================================
# Upstreams
# =============================================
upstream forgejo_upstream {
    zone forgejo_upstream 64k;
    server ${FORGEJO_HOST}:${FORGEJO_HTTP_PORT} resolve max_fails=0 fail_timeout=0;
    keepalive 16;
}

upstream backrest_upstream {
    zone backrest_upstream 64k;
    server ${BACKREST_HOST}:${BACKREST_PORT} resolve max_fails=0 fail_timeout=0;
    keepalive 16;
}

upstream forgejo_registry_upstream {
    zone forgejo_registry_upstream 64k;
    server ${FORGEJO_HOST}:${FORGEJO_HTTP_PORT} resolve max_fails=0 fail_timeout=0;
    keepalive 16;
}

# =============================================
# Map for WebSockets
# =============================================
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# =============================================
# HTTP -> HTTPS redirect (rarely used with CF Tunnel)
# =============================================
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    return 301 https://$host$request_uri;
}

# ============================================================
# HTTPS Server for html
# ============================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name ${CF_HOSTNAME};

    ssl_certificate     ${NG_CERT_PATH}paulosergio.pierdona.nom.br-fullchain.pem;
    ssl_certificate_key ${NG_KEY_PATH}paulosergio.pierdona.nom.br-privkey.pem;
    ssl_dhparam         ${NG_DHPARAMS};

    include /etc/letsencrypt/options-ssl-nginx.conf;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer-when-downgrade always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'self';" always;

    # Root (optional homepage)
    location / {
        root /etc/nginx/html;
        index index.html;
    }
}

# ============================================================
# SERVER: git.paulosergio.pierdona.nom.br
# ============================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name git.${CF_HOSTNAME};

    ssl_certificate     ${NG_CERT_PATH}git.paulosergio.pierdona.nom.br-fullchain.pem;
    ssl_certificate_key ${NG_KEY_PATH}git.paulosergio.pierdona.nom.br-privkey.pem;
    ssl_dhparam         ${NG_DHPARAMS};

    include /etc/letsencrypt/options-ssl-nginx.conf;
    
    client_max_body_size 1G;

    # Forgejo UI
    location / {
        proxy_pass http://forgejo_upstream;
        proxy_set_header Host ${FORGEJO_HOST};
        proxy_set_header X-Real-IP               $remote_addr;
        proxy_set_header X-Forwarded-For         $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto       $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade                 $http_upgrade;
        proxy_set_header Connection              $connection_upgrade;
        proxy_buffering off;
    }
}

# ============================================================
# SERVER: registry.paulosergio.pierdona.nom.br (DOCKER REGISTRY)
# ============================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name registry.${CF_HOSTNAME};

    ssl_certificate     ${NG_CERT_PATH}registry.paulosergio.pierdona.nom.br-fullchain.pem;
    ssl_certificate_key ${NG_KEY_PATH}registry.paulosergio.pierdona.nom.br-privkey.pem;
    ssl_dhparam         ${NG_DHPARAMS};

    include /etc/letsencrypt/options-ssl-nginx.conf;

    client_max_body_size 5G;


    location / {
        proxy_pass http://forgejo_registry_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}

