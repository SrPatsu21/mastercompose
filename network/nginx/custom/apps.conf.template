# =============================================
# Global Resolver
# =============================================
resolver 127.0.0.11 valid=30s ipv6=off;

# =============================================
# Upstreams
# =============================================
upstream gitlab_upstream {
    zone gitlab_upstream 64k;
    server ${GITLAB_HOST}:${GITLAB_PORT} resolve max_fails=0 fail_timeout=0;
    keepalive 16;
}

upstream backrest_upstream {
    zone backrest_upstream 64k;
    server ${BACKREST_HOST}:${BACKREST_PORT} resolve max_fails=0 fail_timeout=0;
    keepalive 16;
}

upstream minecraft_havem_upstream {
    zone minecraft_havem_upstream 64k;
    server ${MINECRAFT_HOST}:${MINECRAFT_HAVEN_PORT} resolve max_fails=0 fail_timeout=0;
    keepalive 16;
}

# =============================================
# Map for WebSockets
# =============================================
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# =============================================
# HTTP -> HTTPS redirect
# =============================================
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${SERVER_NAME};
    return 301 https://$host$request_uri;
}

# =============================================
# HTTPS Server for all apps
# =============================================
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;

    server_name ${SERVER_NAME};

    ssl_certificate ${NG_CERT};
    ssl_certificate_key ${NG_KEY};
    ssl_dhparam ${NG_DHPARAMS};

    include /etc/letsencrypt/options-ssl-nginx.conf;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer-when-downgrade always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'self';" always;

    # =============================================
    # Root landing page
    # =============================================
    location / {
        root /etc/nginx/html;
        index index.html;
    }

    # =============================================
    # GitLab
    # =============================================
    location /${GITLAB_SERVER_NAME}/ {
        proxy_pass http://gitlab_upstream/${GITLAB_SERVER_NAME}/;
        proxy_set_header Host ${GITLAB_SERVER_NAME};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;

        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
    }

    # =============================================
    # Backrest
    # =============================================
    location /${BACKREST_SERVER_NAME}/ {
        proxy_pass http://backrest_upstream/;
        proxy_set_header Host ${BACKREST_SERVER_NAME};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;

        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
    }

    # =============================================
    # Minecraft Haven
    # =============================================
    location /${MINECRAFT_HAVEN_SERVER_NAME}/ {
        proxy_pass http://minecraft_havem_upstream/;
        proxy_set_header Host ${MINECRAFT_HAVEN_SERVER_NAME};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;

        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
    }
}