# =============================================
# ZeroTier
# =============================================
ZT_NETWORK=your_network_id
ZT_IP=10.147.19.101
ZT_PORT=30001

# =============================================
# Services
# =============================================
GITLAB_HOST=gitlab
GITLAB_PORT=80
GITLAB_SERVER_NAME=gitlab.mc.localhost

BACKREST_HOST=backrest
BACKREST_PORT=8080
BACKREST_SERVER_NAME=backrest.mc.localhost

# =============================================
# Nginx SSL
# =============================================
SSL_CERT_PATH=/etc/letsencrypt/live/dummy/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/dummy/privkey.pem

# =============================================
# Docker volumes
# =============================================
NGINX_DATA=./network/nginx/data
NGINX_LETSENCRYPT=./network/nginx/letsencrypt
NGINX_CUSTOM=./network/nginx/custom

ZEROTIER_DATA=./network/zerotier
