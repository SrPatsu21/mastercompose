# env
.env

# No cert, key or pass
*.pem
*.secret

# ZeroTier sensitive secrets
/network/zerotier/authtoken.secret
/network/zerotier/identity.secret
/network/zerotier/metricstoken.secret

# GitLab
core/gitlab/config/*
core/gitlab/data/*
core/gitlab/logs/*

# Runtime files (not needed in git)
/network/zerotier/zerotier-one.pid
/network/zerotier/zerotier-one.port
/network/zerotier/peers.d
/network/zerotier/planet
/network/zerotier/metrics.prom
network/zerotier/controller.d/

# Let's Encrypt auto-generated certs (optional, can regenerate)
/network/nginx/letsencrypt/live/
/network/nginx/letsencrypt/archive/
/network/nginx/letsencrypt/renewal/

# Docker data (optional, often rebuilt)
/network/nginx/data/*
!/network/nginx/data/.gitkeep  # keep empty folder if needed

# Logs
*.log
*.out
