# =============================================
# ZeroTier
# =============================================
ZT_NETWORK=your_network_id
ZT_PORT=30120
ZT_ADDRS=10.147.18.1

# volumes
ZEROTIER_DATA=./network/zerotier

# =============================================
# Cloudflare
# =============================================
CF_API_KEY=your_cloudflare_token
CF_ZONE=yourdomain.nom.br
CF_SUBDOMAIN=yourdomain (@ for none)

# =============================================
# Nginx SSL
# =============================================
SSL_CERT_PATH=/etc/letsencrypt/live/dummy/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/dummy/privkey.pem

DAYS_VALID=365
SSL_SIZE=2048

# volumes
NGINX_DATA=./network/nginx/data
NGINX_LETSENCRYPT=./network/nginx/letsencrypt
NGINX_CUSTOM=./network/nginx/custom
NGINX_HTML=./network/nginx/html

# =============================================
# Services
# =============================================

# GitLab
GITLAB_HOST=gitlab
GITLAB_PORT=80
GITLAB_SERVER_NAME=gitlab.mc.localhost
GITLAB_USER=admin
GITLAB_PASSWORD=strongpassword
GITLAB_EMAIL=admin@example.com

# Backrest
BACKREST_HOST=backrest
BACKREST_PORT=8080
BACKREST_SERVER_NAME=backrest.mc.localhost
BACKREST_S3_ENDPOINT=s3.amazonaws.com
BACKREST_S3_BUCKET=my-gitlab-backups
BACKREST_S3_KEY=YOUR_ACCESS_KEY
BACKREST_S3_SECRET=YOUR_SECRET_KEY
BACKREST_S3_REGION=us-east-1
BACKUP_DIR_PATH=backups/
